<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net8.0-windows porque um dos testes desenha um PNG real com o QRCoder
    (a biblioteca que a app usa) e lê-o de volta com o ZXing. Os testes de
    payload em si são independentes do Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>QrCodeGenerator.Tests</RootNamespace>

    <!--
      WinForms, para poder testar a interface.

      **Esta linha e' a resposta a um bug que noutro sitio nao foi visto:** tres
      campos do VCard estavam por baixo do fundo de um painel de 280 px, sem barra
      e sem atalho, e os 188 testes so olhavam para o payload. Um teste que nao
      desenha a janela nao vê um campo que a janela esconde.

      O projecto ja era `net8.0-windows` porque o `RenderTests` desenha um PNG,
      portanto isto nao acrescenta uma plataforma — acrescenta uma funcionalidade.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\QrCodeGenerator.Core.csproj" />

    <!--
      A app, para que o `InterfaceTestes` possa abrir o `MainForm` de verdade.

      **Sem esta referencia o teste nao vê a interface**, e um teste de interface
      que nao abre a interface nao testa a interface.
    -->
    <ProjectReference Include="..\desktop-winforms\QrCodeGenerator.csproj" />
  </ItemGroup>

</Project>
