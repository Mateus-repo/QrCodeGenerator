<?xml version="1.0" encoding="utf-8"?>
<!--
  O icone adaptativo.

  **E' um vector drawable, e nao um PNG, e a razao tem tres partes.** Um PNG
  teria de vir em varias densidades e o repositorio diria qual e' o certo; um
  vector e' uma geometria e o Android escala. E a mesma forma que o
  `web/tools/gerar-icone.mjs` gera para o site — **o mesmo QR como icone nas
  duas plataformas**, o que faz a app e o site serem reconhecíveis como o mesmo
  programa.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_qr" />
</adaptive-icon>
